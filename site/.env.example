# CloudBase PostgreSQL environment and private PG Storage bucket
CLOUDBASE_ENV_ID=goujianyunzong-pg-d8d7fzcb258b4d
CLOUDBASE_STORAGE_BUCKET=goujianyunzong-files

# PostgreSQL connection (server-side only)
